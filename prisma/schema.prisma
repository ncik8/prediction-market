// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User with fake balance
model User {
  id        String   @id @default(cuid())
  telegramId String  @unique
  username  String?
  balance   Float    @default(10000) // Fake $10,000
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets      Bet[]
  positions Position[]
}

// Prediction market
model Market {
  id          String   @id @default(cuid())
  question    String
  description String?
  imageUrl    String?
  
  // Market details
  asset       String   // e.g., "BTC", "ETH"
  targetPrice Float?   // Target price for prediction
  endTime     DateTime
  
  // Current state
  yesPrice    Float    @default(0.50) // 0.50 = 50%
  noPrice     Float    @default(0.50)
  volume      Float    @default(0)
  
  // Resolution
  status      MarketStatus @default(ACTIVE)
  outcome     String?     // "yes" or "no" or "draw"
  resolvedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bets        Bet[]
  positions   Position[]
}

enum MarketStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

// Individual bet placement
model Bet {
  id          String   @id @default(cuid())
  userId      String
  marketId    String
  
  side        String   // "yes" or "no"
  amount      Float    // Amount in USD
  price       Float    // Price when bet was placed
  
  // For calculating P&L
  tokens      Float    // Number of tokens bought
  
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  market      Market   @relation(fields: [marketId], references: [id])
}

// User's current position in a market
model Position {
  id          String   @id @default(cuid())
  userId      String
  marketId    String
  
  side        String   // "yes" or "no"
  amount      Float    // Total amount invested
  tokens      Float    // Current token balance
  avgPrice    Float    // Average entry price
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  market      Market   @relation(fields: [marketId], references: [id])
}

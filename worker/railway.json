{
  "$schema": "https://railway.app/schema.json",
  "name": "price-worker",
  "build": {
    "builder": "NIXPACKS",
    "install": {
      "packages": ["ws", "@supabase/supabase-js"]
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "node price-worker.js"
  }
}
